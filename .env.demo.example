# Demo-only frontend/browser-safe values.
# Copy values only into an untracked local frontend env file after confirming the demo Supabase project.
# Never use live Supabase, live Google Storage, or production API keys here.

VITE_APP_ENV=demo
VITE_DEMO_MODE=true

VITE_SUPABASE_URL=https://demo-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=demo-anon-key-placeholder

VITE_GEMINI_API_KEY=demo-gemini-key-placeholder

DEMO_STORAGE_BUCKET=demo-storage-bucket-placeholder
DEMO_STORAGE_PREFIX=demo/
