# Demo-only local script values.
# Copy values only into an untracked script-only env file when seeding a disposable demo Supabase project.
# Do not place service-role keys in frontend/browser env files.
#
# SECURITY:
# - SUPABASE_SERVICE_ROLE_KEY must never be exposed in frontend/browser code.
# - Never commit a real service-role key.
# - Never use a live/main Supabase service-role key in the training/demo app.
# - Use this only locally against a disposable demo Supabase project.

SUPABASE_SERVICE_ROLE_KEY=demo-service-role-key-placeholder
